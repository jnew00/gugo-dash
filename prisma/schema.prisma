// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tweet {
  id        String   @id @default(cuid())
  tweetUrl  String   @unique
  tweetText String   @db.Text
  tweetId   String   @unique
  author    String
  source    Source
  status    Status   @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies   Reply[]

  @@map("tweets")
}

model BaseImage {
  id          String   @id @default(cuid())
  filename    String
  path        String
  description String?
  uploadedAt  DateTime @default(now())
  replies     Reply[]

  @@map("base_images")
}

model Meme {
  id          String   @id @default(cuid())
  filename    String
  path        String
  tags        String[] @default([])
  description String?
  analyzed    Boolean  @default(false)
  uploadedAt  DateTime @default(now())
  replies     Reply[]

  @@map("memes")
}

model AdminSettings {
  id                String   @id @default("admin")
  textProvider      String   @default("local")
  imageProvider     String   @default("together")
  memeMatchModel    String   @default("local")
  memeAnalysisModel String   @default("local")
  updatedAt         DateTime @updatedAt

  @@map("admin_settings")
}

model Hashtag {
  id        String   @id @default(cuid())
  tag       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("hashtags")
}

model Mention {
  id        String   @id @default(cuid())
  handle    String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("mentions")
}

model Reply {
  id              String     @id @default(cuid())
  tweetId         String
  tweet           Tweet      @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  replyText       String     @db.Text
  imageId         String?
  baseImage       BaseImage? @relation(fields: [imageId], references: [id])
  memeId          String?
  meme            Meme?      @relation(fields: [memeId], references: [id])
  imagePath       String?
  imageUrl        String?
  twitterReplyId  String?    // Twitter reply ID for deletion
  postedAt        DateTime?
  createdAt       DateTime   @default(now())

  @@map("replies")
}

enum Source {
  DISCORD
  MANUAL
  HASHTAG
}

enum Status {
  NEW
  REPLIED
  SKIPPED
}